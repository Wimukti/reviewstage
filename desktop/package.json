{
  "name": "reviewstage",
  "version": "0.0.0-dev",
  "description": "ReviewStage is the human review layer for AI-written pull requests. Claude drafts the review privately; you verify, edit and post it as yourself. Desktop app: npx reviewstage",
  "keywords": ["ai-code-review", "pr-review", "pull-request", "code-review", "claude-code", "claude", "github", "human-in-the-loop", "self-hosted", "developer-tools", "electron"],
  "license": "MIT",
  "homepage": "https://reviewstage.dev/",
  "repository": { "type": "git", "url": "https://github.com/Wimukti/reviewstage.git", "directory": "desktop" },
  "bin": { "reviewstage": "./bin/reviewstage.js" },
  "main": "main.js",
  "type": "module",
  "engines": { "node": ">=20" },
  "files": [
    "bin/", "main.js", "preload.cjs", "tools.json", "tools.js", "flock.py", "server.js", "tunnel.js", "lifecycle.js", "update.js", "tailscale.js", "pages/", "assets/", "server/"
  ],
  "scripts": {
    "prepack": "node scripts/prepack.mjs",
    "start": "node bin/reviewstage.js",
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node --test test/smoke.test.mjs"
  },
  "dependencies": {
    "electron": "44.5.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
