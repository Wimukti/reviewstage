{
  "name": "reviewstage-dashboard-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.mjs && esbuild src/main.tsx --bundle --minify --jsx=automatic --outdir=../bin/static --entry-names=app --loader:.png=dataurl --define:process.env.NODE_ENV='\"production\"' && node scripts/icons.mjs",
    "dev": "node scripts/clean.mjs && esbuild src/main.tsx --bundle --sourcemap --jsx=automatic --outdir=../bin/static --entry-names=app --loader:.png=dataurl --define:process.env.NODE_ENV='\"development\"' --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "test:browser": "playwright test",
    "icons": "node scripts/icons.mjs",
    "brand": "node scripts/brand.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "0.25.8",
    "sharp": "0.34.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
