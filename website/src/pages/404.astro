---
import { SearchX } from "lucide-react";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { button } from "../components/marketing/variants";
import { withBase } from "../content/site-links";
---
<MarketingLayout title="Not found – ReviewStage" description="That page does not exist." noindex>
  <section class="container-page grid max-w-[40rem] gap-4 py-[var(--section-pad)]">
    <SearchX className="size-10 text-muted-foreground" strokeWidth={1.5} aria-hidden="true" />
    <h1 class="section-title">Nothing staged here.</h1>
    <p class="m-0 max-w-[72ch] text-base text-muted-foreground">The page moved or never existed.</p>
    <div class="flex flex-wrap gap-3">
      <a class={button({}, "max-sm:h-11")} href={withBase("/")}>Home page</a>
      <a class={button({ variant: "secondary" }, "max-sm:h-11")} href={withBase("/start/")}>Docs</a>
    </div>
  </section>
</MarketingLayout>
