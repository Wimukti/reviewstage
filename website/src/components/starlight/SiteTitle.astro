---
import Mark from "../marketing/Mark.astro";
import { withBase } from "../../content/site-links";
---
<a class="brand" href={withBase("/")} translate="no">
  <span class="brand-mark"><Mark size={17} /></span>
  <span>ReviewStage</span>
  <span class="brand-chip">Docs</span>
</a>
<style>
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; min-width: 0; color: var(--foreground); font-family: var(--font-display); font-size: 1.02rem; font-weight: 700; letter-spacing: -0.03em; text-decoration: none; white-space: nowrap; }
  .brand-mark { display: grid; place-items: center; width: 1.95rem; height: 1.95rem; border: 1px solid var(--hairline); border-radius: 0.65rem; background: color-mix(in oklab, var(--foreground) 5%, transparent); }
  .brand-chip { padding: 0.05rem 0.45rem; border: 1px solid var(--hairline); border-radius: 999px; color: var(--muted-foreground); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  @media (max-width: 50rem) { .brand-chip { display: none; } }
</style>
