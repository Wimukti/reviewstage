---
/* The hero's live simulated run: six panels that play the product story in sequence.
 * Pure DOM, driven by src/scripts/live-run.ts. Height is fixed per breakpoint so the
 * hero never reflows between steps. */
const steps = [
  { key: "Requested", caption: "Someone asks for your review. Nothing has run yet." },
  { key: "Run", caption: "Click-to-run, on your own Claude plan. Never automatic." },
  { key: "Drafting", caption: "Runs on your Claude subscription. Profiles critical paths." },
  { key: "Staged", caption: "Every finding is staged privately. Nothing is on GitHub." },
  { key: "Decide", caption: "Keep, edit, or drop. Your judgment, your words." },
  { key: "Posted", caption: "Posts under your own name. Never as a bot." },
];
const findings = [
  { sev: "high", title: "Retry can refund twice on a timed-out capture", why: "A gateway timeout is not a failure; the first attempt may have succeeded.", at: "payments/refunds/retry.ts:88", critical: true },
  { sev: "high", title: "Idempotency key is regenerated on every retry", why: "Each attempt looks new to the gateway, so its dedupe never fires.", at: "payments/refunds/client.ts:41" },
  { sev: "medium", title: "Backoff has no jitter", why: "Synchronised retries after an outage spike the gateway at once.", at: "payments/refunds/retry.ts:112" },
  { sev: "medium", title: "Timeout error is swallowed into a generic 500", why: "Ops cannot tell a slow gateway from a bug.", at: "payments/api/refund.ts:57" },
  { sev: "medium", title: "Test covers the happy path only", why: "No case for timed out, then succeeded.", at: "payments/refunds/retry.test.ts:19" },
  { sev: "low", title: "RETRY_LIMIT is a magic number", why: "Three lives in two files; name it once.", at: "payments/refunds/retry.ts:9" },
];
/* Step-5 acts on the finding rows, by index. */
const acts: Record<number, { t: number; act: string }> = {
  2: { t: 300, act: "untick" },
  4: { t: 1000, act: "untick" },
  0: { t: 1700, act: "edit" },
};
---
<figure class="lr" data-live-run data-step="1" aria-label="Simulated ReviewStage run">
  <div class="lr-frame">
    <div class="lr-bar">
      <span class="lr-chip">reviewstage · acme/payments #482 · <span class="lr-live">live<i aria-hidden="true"></i></span></span>
      <span class="lr-counter" data-counter aria-live="polite">1 / 6</span>
    </div>
    <div class="lr-screen">
      <!-- 1 · Review requested -->
      <div class="lr-panel lr-p1" data-panel="1">
        <div class="lr-slack" data-t="60">
          <div class="lr-slack-app" aria-hidden="true">RS</div>
          <div class="lr-slack-body">
            <div class="lr-slack-head"><b>ReviewStage</b> <span class="lr-app">APP</span> <span class="lr-dim">9:41</span></div>
            <p><b>@you</b> was requested to review <b>#482</b></p>
            <div class="lr-slack-att">
              <div class="lr-slack-title">Refund flow: retry on gateway timeout</div>
              <div class="lr-mono lr-dim">acme/payments · <span class="lr-add">+412</span> <span class="lr-del">−38</span> · 9 files</div>
              <span class="lr-btn lr-btn-ghost">Open in ReviewStage</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 2 · You choose the run -->
      <div class="lr-panel lr-p2" data-panel="2">
        <div class="lr-form">
          <div class="lr-field">
            <span class="lr-label">Effort</span>
            <div class="lr-seg">
              <span class="lr-seg-opt lr-seg-on">Quick</span>
              <span class="lr-seg-opt" data-t="520">Standard <span class="lr-auto" data-t="760" data-s="2">auto-suggested</span></span>
              <span class="lr-seg-opt">Deep</span>
            </div>
          </div>
          <div class="lr-field">
            <span class="lr-label">Model</span>
            <div class="lr-chips">
              <span class="lr-chip-opt">Default</span>
              <span class="lr-chip-opt">Opus</span>
              <span class="lr-chip-opt lr-chip-on">Sonnet</span>
              <span class="lr-chip-opt">Haiku</span>
            </div>
          </div>
          <div class="lr-field">
            <span class="lr-label">Focus <span class="lr-dim">optional</span></span>
            <div class="lr-input" data-t="900"><span data-type>check idempotency on retries</span><i class="lr-caret" aria-hidden="true"></i></div>
          </div>
          <div class="lr-form-foot">
            <span class="lr-dim lr-mono">billed to your plan · ~12 min</span>
            <span class="lr-btn lr-btn-primary" data-t="2300">Start review</span>
          </div>
        </div>
      </div>

      <!-- 3 · Drafting -->
      <div class="lr-panel lr-p3" data-panel="3">
        <div class="lr-run">
          <div class="lr-run-head">
            <span><span class="lr-spin" aria-hidden="true"></span>Drafting · standard · sonnet</span>
            <span class="lr-dim lr-mono">worktree rs-482</span>
          </div>
          <div class="lr-progress" aria-hidden="true"><i data-t="120"></i></div>
          <ol class="lr-log lr-mono">
            <li data-t="200"><span class="lr-dim">00:02</span> checked out worktree</li>
            <li data-t="700"><span class="lr-dim">00:05</span> reading 9 files</li>
            <li data-t="1200"><span class="lr-dim">00:41</span> walking critical path: <b>payments/refunds/**</b></li>
            <li data-t="1800"><span class="lr-dim">03:12</span> <b class="lr-ok">6 findings</b></li>
          </ol>
        </div>
      </div>

      <!-- 4 · Staged and 5 · You decide share one panel -->
      <div class="lr-panel lr-p4" data-panel="4 5">
        <div class="lr-fhead">
          <span><b>6 findings</b> staged</span>
          <span class="lr-pill lr-pill-muted">private draft</span>
        </div>
        <ol class="lr-list" data-t="100" data-s="4">
          {findings.map((f, i) => (
            <li class="lr-finding" style={`--i:${i}`} data-t={acts[i]?.t} data-s={acts[i] ? 5 : undefined} data-act={acts[i]?.act}>
              <span class="lr-check" data-hit aria-hidden="true"></span>
              <div class="lr-fbody">
                <div class="lr-frow">
                  <span class={`lr-sev lr-sev-${f.sev}`}>{f.sev}</span>
                  <span class="lr-ftitle">{acts[i]?.act === "edit" ? <span data-edit="charge" data-cut="7">{f.title}</span> : f.title}</span>
                  {f.critical && <span class="lr-pill lr-pill-crit">critical path</span>}
                </div>
                <div class="lr-fmeta"><span class="lr-fwhy">{f.why}</span><span class="lr-fat lr-mono">{f.at}</span></div>
              </div>
            </li>
          ))}
        </ol>
        <div class="lr-postbar">
          <span class="lr-dim"><b data-count>6</b> of 6 selected · COMMENT review</span>
          <span class="lr-btn lr-btn-primary lr-post" data-t="3000" data-s="5" data-act="press"><span>Post <b data-count>6</b> as you</span></span>
        </div>
      </div>

      <!-- 6 · Posted as you -->
      <div class="lr-panel lr-p6" data-panel="6">
        <div class="lr-gh" data-t="40">
          <div class="lr-gh-head">
            <span class="lr-avatar" aria-hidden="true">Y</span>
            <span><b>you</b> commented · 4 comments</span>
            <span class="lr-pill lr-pill-muted">COMMENT</span>
          </div>
          <ul class="lr-gh-list">
            <li><span class="lr-mono lr-dim">retry.ts:88</span> Retry can refund twice on a timed-out charge</li>
            <li><span class="lr-mono lr-dim">client.ts:41</span> Idempotency key is regenerated on every retry</li>
            <li><span class="lr-mono lr-dim">refund.ts:57</span> Timeout error is swallowed into a generic 500</li>
            <li><span class="lr-mono lr-dim">retry.ts:9</span> RETRY_LIMIT is a magic number</li>
          </ul>
          <div class="lr-gh-foot">
            <span class="lr-dim">Approval is a separate click.</span>
            <span class="lr-btn lr-btn-ghost lr-approve">Approve</span>
          </div>
        </div>
        <div class="lr-toast" data-t="700" role="status">Posted as <b>@you</b> — COMMENT review</div>
      </div>

      <span class="lr-cursor" aria-hidden="true"></span>
    </div>
  </div>

  <figcaption class="lr-foot">
    <div class="lr-caption">
      {steps.map((s, i) => <p data-caption hidden={i !== 0}>{s.caption}</p>)}
    </div>
    <div class="lr-steps" role="group" aria-label="Steps of the simulated run">
      {steps.map((s, i) => (
        <button type="button" class="lr-step" data-lr-step={i + 1} aria-current={i === 0 ? "step" : "false"} aria-pressed="false" tabindex={i === 0 ? 0 : -1}>
          <i aria-hidden="true"></i><span>{s.key}</span>
        </button>
      ))}
    </div>
  </figcaption>
</figure>

<style>
  .lr { --lr-h: 30rem; --lr-ease: var(--ease-out-expo); margin: 0; display: grid; gap: 0.9rem; font-size: 0.8125rem; line-height: 1.45; color: var(--foreground); }
  .lr-frame { position: relative; border: 1px solid var(--hairline); border-radius: var(--radius-device); background: var(--surface-elevated); box-shadow: var(--shadow-elevated); overflow: hidden; }
  .lr-bar { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; height: 2.1rem; padding-inline: 0.75rem; border-bottom: 1px solid var(--hairline); }
  .lr-chip { display: inline-flex; align-items: center; gap: 0.3rem; min-width: 0; padding: 0.08rem 0.5rem; border: 1px solid var(--hairline); border-radius: 999px; color: var(--muted-foreground); font-family: var(--font-mono); font-size: 0.68rem; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lr-live { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--success); }
  .lr-live i { width: 0.4rem; height: 0.4rem; border-radius: 999px; background: var(--success); box-shadow: 0 0 0 0 color-mix(in oklab, var(--success) 60%, transparent); animation: lr-pulse 1.8s ease-out infinite; }
  @keyframes lr-pulse { 0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--success) 55%, transparent); } 70% { box-shadow: 0 0 0 0.35rem transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .lr-counter { flex: none; white-space: nowrap; color: var(--muted-foreground); font-family: var(--font-mono); font-size: 0.68rem; font-variant-numeric: tabular-nums; }

  .lr-screen { position: relative; height: var(--lr-h); overflow: hidden; background: var(--card); }
  .lr-panel { position: absolute; inset: 0; padding: 1rem; display: grid; align-content: start; gap: 0.75rem; opacity: 0; translate: 0 0.5rem; visibility: hidden; transition: opacity 320ms var(--lr-ease), translate 320ms var(--lr-ease), visibility 0s 320ms; }
  .lr-panel.active { opacity: 1; translate: 0 0; visibility: visible; transition-delay: 0s; }

  .lr-mono { font-family: var(--font-mono); font-size: 0.72rem; }
  .lr-dim { color: var(--muted-foreground); }
  .lr-add { color: var(--success); } .lr-del { color: var(--destructive); } .lr-ok { color: var(--success); }
  .lr-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 1.85rem; padding-inline: 0.75rem; border: 1px solid var(--hairline); border-radius: var(--radius-chip); font-weight: 600; font-size: 0.78rem; white-space: nowrap; }
  .lr-btn-ghost { background: color-mix(in oklab, var(--foreground) 5%, transparent); }
  .lr-btn-primary { border-color: color-mix(in oklab, var(--primary) 65%, transparent); background: var(--primary); color: var(--primary-foreground); }
  .lr-pill { display: inline-flex; align-items: center; padding: 0.05rem 0.45rem; border-radius: 999px; font-family: var(--font-mono); font-size: 0.62rem; line-height: 1.5; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap; }
  .lr-pill-muted { border: 1px solid var(--hairline); color: var(--muted-foreground); }
  .lr-pill-crit { background: color-mix(in oklab, var(--primary) 18%, transparent); color: var(--primary); }

  /* 1 · Slack card */
  .lr-p1 { align-content: center; }
  .lr-slack { display: grid; grid-template-columns: 2.25rem 1fr; gap: 0.7rem; padding: 0.9rem; border: 1px solid var(--hairline); border-radius: var(--radius-card); background: var(--surface-elevated); opacity: 0; translate: 0 1rem; transition: opacity 420ms var(--lr-ease), translate 520ms var(--lr-ease); }
  .lr-slack.in { opacity: 1; translate: 0 0; }
  .lr-slack-app { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 0.5rem; background: linear-gradient(150deg, var(--primary), color-mix(in oklab, var(--primary) 60%, var(--warning))); color: var(--primary-foreground); font-weight: 700; font-size: 0.75rem; }
  .lr-slack-body { display: grid; gap: 0.3rem; min-width: 0; }
  .lr-slack-body p { margin: 0; }
  .lr-slack-head { display: flex; align-items: baseline; gap: 0.4rem; }
  .lr-app { padding: 0 0.3rem; border-radius: 0.25rem; background: color-mix(in oklab, var(--foreground) 10%, transparent); font-size: 0.6rem; font-weight: 600; letter-spacing: 0.03em; }
  .lr-slack-att { display: grid; gap: 0.35rem; margin-top: 0.3rem; padding: 0.55rem 0.75rem; border-left: 3px solid var(--primary); background: color-mix(in oklab, var(--foreground) 4%, transparent); border-radius: 0.25rem 0.5rem 0.5rem 0.25rem; }
  .lr-slack-title { font-weight: 600; }
  .lr-slack-att .lr-btn { justify-self: start; margin-top: 0.2rem; }

  /* 2 · Run form */
  .lr-form { display: grid; gap: 0.85rem; padding: 0.9rem; border: 1px solid var(--hairline); border-radius: var(--radius-card); background: var(--surface-elevated); }
  .lr-field { display: grid; gap: 0.35rem; }
  .lr-label { display: flex; justify-content: space-between; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted-foreground); }
  .lr-seg { display: grid; grid-template-columns: repeat(3, 1fr); padding: 0.2rem; border: 1px solid var(--hairline); border-radius: var(--radius-chip); background: color-mix(in oklab, var(--foreground) 4%, transparent); }
  .lr-seg-opt { position: relative; display: flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 1.8rem; border-radius: 0.35rem; color: var(--muted-foreground); font-weight: 500; transition: background-color 260ms var(--lr-ease), color 260ms var(--lr-ease); }
  .lr-seg-opt.in { background: var(--card); color: var(--foreground); box-shadow: 0 1px 0 var(--hairline); }
  .lr-seg-on { background: var(--card); color: var(--foreground); box-shadow: 0 1px 0 var(--hairline); }
  .lr-seg:has(.in) .lr-seg-on { background: transparent; color: var(--muted-foreground); box-shadow: none; }
  .lr-auto { position: absolute; top: -0.65rem; right: -0.25rem; padding: 0.02rem 0.35rem; border-radius: 999px; background: var(--primary); color: var(--primary-foreground); font-size: 0.55rem; font-weight: 600; letter-spacing: 0.04em; opacity: 0; scale: 0.8; transition: opacity 240ms var(--lr-ease), scale 340ms var(--ease-spring); }
  .lr-auto.in { opacity: 1; scale: 1; }
  .lr-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .lr-chip-opt { padding: 0.15rem 0.6rem; border: 1px solid var(--hairline); border-radius: 999px; color: var(--muted-foreground); }
  .lr-chip-on { border-color: color-mix(in oklab, var(--primary) 50%, transparent); background: color-mix(in oklab, var(--primary) 14%, transparent); color: var(--foreground); }
  .lr-input { display: flex; align-items: center; min-height: 2.1rem; padding: 0.4rem 0.6rem; border: 1px solid var(--hairline); border-radius: var(--radius-chip); background: var(--card); font-family: var(--font-mono); font-size: 0.74rem; }
  .lr-input.in { border-color: color-mix(in oklab, var(--primary) 45%, var(--border)); }
  .lr-caret { width: 1px; height: 1em; margin-left: 1px; background: var(--foreground); opacity: 0; }
  .lr-input.in .lr-caret { animation: lr-blink 1s steps(2) infinite; }
  @keyframes lr-blink { to { opacity: 1; } }
  .lr-form-foot { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .lr-form-foot .lr-btn-primary { opacity: 0.55; transition: opacity 260ms var(--lr-ease), box-shadow 260ms var(--lr-ease); }
  .lr-form-foot .lr-btn-primary.in { opacity: 1; box-shadow: var(--glow-primary); }

  /* 3 · Drafting */
  .lr-run { display: grid; gap: 0.75rem; padding: 0.9rem; border: 1px solid var(--hairline); border-radius: var(--radius-card); background: var(--surface-elevated); }
  .lr-run-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; font-weight: 600; }
  .lr-run-head > span:first-child { display: inline-flex; align-items: center; gap: 0.5rem; }
  .lr-spin { width: 0.7rem; height: 0.7rem; border-radius: 999px; border: 2px solid color-mix(in oklab, var(--primary) 30%, transparent); border-top-color: var(--primary); animation: lr-spin 0.9s linear infinite; }
  @keyframes lr-spin { to { rotate: 360deg; } }
  .lr-progress { height: 0.3rem; border-radius: 999px; background: color-mix(in oklab, var(--foreground) 8%, transparent); overflow: hidden; }
  .lr-progress i { display: block; height: 100%; width: 4%; border-radius: 999px; background: linear-gradient(90deg, var(--primary), color-mix(in oklab, var(--primary) 60%, var(--warning))); transition: width 2200ms cubic-bezier(0.2, 0.7, 0.3, 1); }
  .lr-progress i.in { width: 92%; }
  .lr-log { display: grid; gap: 0.3rem; margin: 0; padding: 0.6rem 0.7rem; list-style: none; border-radius: var(--radius-chip); background: var(--card); }
  .lr-log li { opacity: 0; translate: -0.35rem 0; transition: opacity 260ms var(--lr-ease), translate 320ms var(--lr-ease); }
  .lr-log li.in { opacity: 1; translate: 0 0; }
  .lr-log .lr-dim { margin-right: 0.5rem; }

  /* 4 + 5 · Findings */
  .lr-p4 { gap: 0.6rem; grid-template-rows: auto 1fr auto; }
  .lr-fhead { display: flex; align-items: center; justify-content: space-between; }
  .lr-list { display: grid; gap: 0.35rem; margin: 0; padding: 0; list-style: none; align-content: start; min-height: 0; overflow: hidden; }
  .lr-finding { display: grid; grid-template-columns: 1rem 1fr; gap: 0.6rem; align-items: start; padding: 0.45rem 0.65rem; border: 1px solid var(--hairline); border-radius: var(--radius-chip); background: var(--surface-elevated); opacity: 0; translate: 0 0.5rem; transition: opacity 320ms var(--lr-ease), translate 420ms var(--lr-ease), border-color 200ms, box-shadow 200ms, transform 120ms var(--lr-ease); }
  .lr-list.in .lr-finding { opacity: 1; translate: 0 0; transition-delay: calc(var(--i) * 90ms), calc(var(--i) * 90ms), 0s, 0s, 0s; }
  .lr-finding:hover { transform: translateY(-2px); box-shadow: var(--shadow-soft); }
  .lr-finding.off { opacity: 0.42; transition-delay: 0s; }
  .lr-finding.off .lr-check { background: transparent; border-color: var(--border); }
  .lr-finding.off .lr-check::after { opacity: 0; }
  .lr-finding.open { border-color: color-mix(in oklab, var(--primary) 55%, var(--border)); box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 16%, transparent); }
  .lr-finding.open [data-edit] { border-bottom: 1px dashed color-mix(in oklab, var(--primary) 70%, transparent); }
  .lr-check { position: relative; width: 1rem; height: 1rem; margin-top: 0.1rem; border: 1px solid color-mix(in oklab, var(--primary) 70%, transparent); border-radius: 0.3rem; background: var(--primary); transition: background-color 200ms, border-color 200ms; }
  .lr-check::after { content: ""; position: absolute; left: 0.3rem; top: 0.1rem; width: 0.28rem; height: 0.55rem; border: solid var(--primary-foreground); border-width: 0 2px 2px 0; rotate: 45deg; transition: opacity 200ms; }
  .lr-fbody { display: grid; gap: 0.05rem; min-width: 0; }
  .lr-fmeta { display: flex; flex-wrap: wrap; gap: 0.15rem 0.6rem; align-items: baseline; }
  .lr-frow { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .lr-ftitle { font-weight: 600; }
  .lr-fwhy { color: var(--muted-foreground); font-size: 0.74rem; }
  .lr-fat { color: var(--muted-foreground); font-size: 0.64rem; opacity: 0.85; }
  .lr-sev { padding: 0 0.4rem; border-radius: 999px; font-family: var(--font-mono); font-size: 0.6rem; line-height: 1.5; text-transform: uppercase; letter-spacing: 0.05em; }
  .lr-sev-high { background: color-mix(in oklab, var(--destructive) 18%, transparent); color: var(--destructive); }
  .lr-sev-medium { background: color-mix(in oklab, var(--warning) 20%, transparent); color: var(--warning); }
  .lr-sev-low { background: color-mix(in oklab, var(--info) 18%, transparent); color: var(--info); }
  .lr-postbar { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding-top: 0.6rem; border-top: 1px solid var(--hairline); }
  .lr-post { opacity: 0.55; transition: opacity 260ms var(--lr-ease), box-shadow 260ms var(--lr-ease); }
  .lr-post.in { opacity: 1; box-shadow: var(--glow-primary); }
  .lr[data-step="5"] .lr-fhead .lr-pill::after { content: " · editing"; }

  /* 6 · GitHub review */
  .lr-p6 { align-content: center; }
  .lr-gh { display: grid; gap: 0.7rem; padding: 0.9rem; border: 1px solid var(--hairline); border-radius: var(--radius-card); background: var(--surface-elevated); transform: perspective(1200px) rotateX(-10deg); opacity: 0; transform-origin: 50% 0; transition: opacity 380ms var(--lr-ease), transform 620ms var(--lr-ease); }
  .lr-gh.in { opacity: 1; transform: none; }
  .lr-gh-head { display: flex; align-items: center; gap: 0.55rem; }
  .lr-gh-head .lr-pill { margin-left: auto; }
  .lr-avatar { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 999px; background: linear-gradient(150deg, var(--info), var(--success)); color: var(--background); font-weight: 700; font-size: 0.7rem; }
  .lr-gh-list { display: grid; gap: 0.35rem; margin: 0; padding: 0; list-style: none; }
  .lr-gh-list li { display: flex; gap: 0.6rem; align-items: baseline; padding: 0.4rem 0.6rem; border-left: 2px solid var(--hairline); background: color-mix(in oklab, var(--foreground) 3%, transparent); border-radius: 0 0.4rem 0.4rem 0; }
  .lr-gh-list .lr-mono { flex: 0 0 auto; }
  .lr-gh-foot { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding-top: 0.6rem; border-top: 1px solid var(--hairline); }
