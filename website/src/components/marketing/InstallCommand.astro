---
/* The one-line install: code, so it is the one monospace thing on the page, in its own
 * canvas-toned field inside the install card, with a ghost copy button. */
import { Copy } from "lucide-react";
import { installCommand as cmd } from "../../content/install";
import { button } from "./variants";
---
<div class="install flex w-full min-w-0 max-w-full items-center gap-2.5 rounded-md bg-background py-1 pl-3.5 pr-1" data-install>
  <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap font-mono text-xs text-foreground [contain:inline-size] [scrollbar-width:none] before:mr-2 before:font-medium before:text-primary before:content-['$']">{cmd}</code>
  <button type="button" class={button({ variant: "ghost", size: "icon-sm" }, "copy shrink-0 text-muted-foreground data-[done]:text-green max-sm:size-11")} data-copy={cmd} aria-label="Copy install command">
    <Copy aria-hidden="true" />
  </button>
</div>
