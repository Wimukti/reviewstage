{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": { "@app/*": ["../dashboard-ui/src/*"] }
  },
  "include": [".astro/types.d.ts", "**/*", "../dashboard-ui/src/assets.d.ts"],
  // public/try holds the built replay (a 700 KB bundle) — not for the checker.
  "exclude": ["dist", "public/try"]
}
