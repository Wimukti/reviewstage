---
import Default from "@astrojs/starlight/components/Footer.astro";
import { docsFooterColumns as columns, withBase } from "../../content/site-links";
---
<Default><slot /></Default>
<nav class="mt-10 grid grid-cols-2 gap-7 border-t pt-8 md:grid-cols-4" aria-label="Site">
  {columns.map((c) => (
    <div>
      <h2 class="m-0 mb-2 text-sm font-medium text-foreground">{c.title}</h2>
      <ul class="m-0 grid list-none gap-0.5 p-0">{c.links.map((l) => <li><a class="inline-flex min-h-8 items-center text-sm text-muted-foreground no-underline hover:text-foreground" href={withBase(l.href)}>{l.label}</a></li>)}</ul>
    </div>
  ))}
</nav>
<p class="mt-6 text-xs text-muted-foreground">MIT licensed · Built on Claude Code</p>
