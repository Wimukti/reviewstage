---
import Mark from "./Mark.astro";
import { marketingFooterColumns as columns, withBase } from "../../content/site-links";
---
<footer class="border-t">
  <div class="container-page">
    <div class="grid gap-10 py-14 md:grid-cols-[1.2fr_2.6fr]">
      <div class="max-w-xs">
        <a class="inline-flex items-center gap-2.5 text-base font-semibold tracking-tight text-foreground no-underline" href={withBase("/")}><Mark size={20} /><span>ReviewStage</span></a>
        <p class="mt-4 text-sm text-muted-foreground">Stage your review. Post it as yourself.</p>
      </div>
      <nav class="grid grid-cols-2 gap-8 md:grid-cols-4" aria-label="Footer">
        {columns.map((c) => (
          <div>
            <h2 class="m-0 mb-2 text-sm font-medium text-foreground">{c.title}</h2>
            <ul class="m-0 grid list-none gap-0.5 p-0">{c.links.map((l) => <li><a class="inline-flex min-h-8 items-center text-sm text-muted-foreground no-underline hover:text-foreground max-sm:min-h-11" href={withBase(l.href)}>{l.label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-4 border-t pb-10 pt-6 text-xs text-muted-foreground">
      <p class="m-0">MIT licensed · Beta software · Self-hosted</p>
      <p class="m-0">Built on Claude Code. Not affiliated with Anthropic or GitHub.</p>
    </div>
  </div>
</footer>
