---
interface Props { id?: string; title?: string; lede?: string; align?: "start" | "center"; }
const { id, title, lede, align = "start" } = Astro.props;
const titleId = id ? `${id}-title` : undefined;
---
<section id={id} class="section-block" aria-labelledby={title ? titleId : undefined}>
  <div class="container-page section-inner">
    {(title || lede) && (
      <div class:list={["section-header", align === "center" && "section-header-center"]}>
        {title && <h2 id={titleId} class="section-title">{title}</h2>}
        {lede && <p class="lede">{lede}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
<style>
  .section-block { padding-block: var(--section-pad); border-bottom: 1px solid var(--hairline); }
  .section-block[id] { scroll-margin-top: calc(var(--nav-height) + 1rem); }
  .section-inner { display: grid; gap: var(--section-gap); }
  .section-header { display: flex; flex-direction: column; gap: 0.85rem; max-width: 46rem; }
  .section-header-center { align-items: center; margin-inline: auto; text-align: center; }
</style>
