---
/* Home (openspec/changes/landing-v2/design.md): what it is, why it is different, what it does,
 * why to trust it, how to start. The hero recording is the page's one motion; every other
 * section is static markup with zero JavaScript. */
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Hero from "../components/home/Hero.astro";
import Contrast from "../components/home/Contrast.astro";
import Steps from "../components/home/Steps.astro";
import Features from "../components/home/Features.astro";
import Gate from "../components/home/Gate.astro";
import Compare from "../components/home/Compare.astro";
import Start from "../components/home/Start.astro";
import Faq from "../components/home/Faq.astro";
import FinalCall from "../components/home/FinalCall.astro";
import { categorySentence, homeTitle } from "../content/brand";

const title = homeTitle;
const description = categorySentence;
---
<MarketingLayout {title} {description}>
  <Hero />
  <Contrast />
  <Steps />
  <Features />
  <Gate />
  <Compare />
  <Start />
  <Faq />
  <FinalCall />
</MarketingLayout>
