---
import Mark from "../marketing/Mark.astro";
import { withBase } from "../../content/site-links";
---
<a class="brand" href={withBase("/")} translate="no">
  <Mark size={22} />
  <span>ReviewStage</span>
  <span class="brand-chip">Docs</span>
</a>
<style>
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; min-width: 0; color: var(--ink); font-size: var(--t-16); font-weight: 600; letter-spacing: -0.01em; text-decoration: none; white-space: nowrap; }
  .brand-chip { padding: 0 0.45rem; border: 1px solid var(--hairline); border-radius: var(--r-s); color: var(--graphite); font-size: var(--t-13); font-weight: 500; line-height: 1.5; }
  @media (max-width: 50rem) { .brand-chip { display: none; } }
</style>
