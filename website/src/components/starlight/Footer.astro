---
import Default from "@astrojs/starlight/components/Footer.astro";
import { docsFooterColumns as columns, withBase } from "../../content/site-links";
---
<Default><slot /></Default>
<nav class="site-map" aria-label="Site">
  {columns.map((c) => (
    <div>
      <h2>{c.title}</h2>
      <ul>{c.links.map((l) => <li><a href={withBase(l.href)}>{l.label}</a></li>)}</ul>
    </div>
  ))}
</nav>
<p class="fine">MIT licensed · Built on Claude Code</p>
<style>
  .site-map { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--hairline); }
  @media (min-width: 50rem) { .site-map { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .site-map h2 { margin: 0 0 0.7rem; color: var(--foreground); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  .site-map ul { display: grid; gap: 0.45rem; margin: 0; padding: 0; list-style: none; }
  .site-map a { color: var(--muted-foreground); font-size: 0.875rem; text-decoration: none; }
  .site-map a:hover { color: var(--foreground); }
  .fine { margin-top: 1.5rem; color: var(--muted-foreground); font-size: 0.8rem; }
</style>
