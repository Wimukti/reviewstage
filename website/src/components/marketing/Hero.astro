---
import InstallCommand from "./InstallCommand.astro";
import Shot from "./Shot.astro";
import { repo, withBase } from "../../content/site-links";
---
<section class="hero">
  <span class="hero-glow" aria-hidden="true"></span>
  <div class="container-page hero-shell">
    <div class="hero-copy">
      <span class="badge"><span class="badge-dot" aria-hidden="true"></span>Open source · Self-hosted · Beta</span>
      <h1 class="display-title">AI wrote the PR.<br /><span class="gradient-text">You still have to review it.</span></h1>
      <p class="lede hero-lede">ReviewStage drafts your review from the real diff, on your own Claude plan, and stages every finding privately. You pick what reaches GitHub, edit it, and post it under your own name. Nothing posts until you click.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={withBase("/start/")}>Get started <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={repo} aria-label="ReviewStage on GitHub">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.35-1.3-1.7-1.3-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.03 1.78 2.7 1.27 3.36.97.1-.75.4-1.27.73-1.56-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
          GitHub
        </a>
      </div>
      <div class="hero-install">
        <InstallCommand />
        <p class="meta-text">Docker Compose, then <code class="kbd">http://localhost:8899</code>. Needs a Claude Pro, Max, Team or Enterprise plan for the reviewer who runs it.</p>
      </div>
    </div>
    <div class="hero-stage">
      <Shot name="hero" alt="ReviewStage PR page: the agent's assessment above a list of findings, each with a checkbox, severity, file and line, and an editable body. A sticky bar shows the selected count and a single Post to GitHub button." label="reviewstage · pr #482 · 6 findings staged" loading="eager" />
    </div>
  </div>
</section>
<style>
  .hero { position: relative; isolation: isolate; overflow: clip; padding-block: clamp(3rem, 6vw, 5.5rem) clamp(3.5rem, 6vw, 5.5rem); }
  .hero-glow { position: absolute; z-index: 0; inset: 10% 5% 20% 45%; background: radial-gradient(circle, var(--primary), transparent 62%); opacity: 0.16; filter: blur(90px); pointer-events: none; }
  :global(:root[data-theme="light"]) .hero-glow { opacity: 0.1; }
  .hero-shell { position: relative; z-index: 1; display: grid; align-items: center; gap: clamp(2.5rem, 5vw, 4.5rem); }
  @media (min-width: 64rem) { .hero-shell { grid-template-columns: minmax(0, 6fr) minmax(0, 7fr); } }
  .hero-copy { display: grid; gap: 1.5rem; }
  .hero-lede { max-width: 34rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero-install { display: grid; gap: 0.6rem; max-width: 36rem; }
</style>
