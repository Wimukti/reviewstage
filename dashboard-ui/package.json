{
  "name": "reviewstage-dashboard-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.mjs && esbuild src/main.tsx --bundle --minify --jsx=automatic --outdir=../bin/static --entry-names=app --loader:.png=dataurl --loader:.svg=dataurl --loader:.woff2=file --loader:.woff=empty --define:process.env.NODE_ENV='\"production\"' && node scripts/icons.mjs",
    "dev": "node scripts/clean.mjs && esbuild src/main.tsx --bundle --sourcemap --jsx=automatic --outdir=../bin/static --entry-names=app --loader:.png=dataurl --loader:.svg=dataurl --loader:.woff2=file --loader:.woff=empty --define:process.env.NODE_ENV='\"development\"' --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "test:browser": "playwright test",
    "icons": "node scripts/icons.mjs",
    "brand": "node scripts/brand.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "sharp": "0.35.4",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
