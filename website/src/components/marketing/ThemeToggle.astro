---
/* Three-way segmented control: light, dark, system — the Tabs look (a muted track, the chosen
 * option raised on the canvas). Wired by scripts/theme.ts through [data-theme-option]. */
import { Monitor, Moon, Sun } from "lucide-react";
const options = [
  { value: "light", label: "Light", Icon: Sun },
  { value: "dark", label: "Dark", Icon: Moon },
  { value: "auto", label: "System", Icon: Monitor },
] as const;
---
<div class="inline-flex items-center rounded-lg bg-muted p-[3px]" data-theme-switch role="group" aria-label="Color theme">
  {options.map((o) => (
    <button
      type="button"
      class="inline-flex size-[30px] items-center justify-center rounded-md text-muted-foreground transition-colors hover:text-foreground aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-sm max-sm:size-11"
      data-theme-option={o.value}
      aria-pressed="false"
      title={`${o.label} theme`}
    >
      <span class="sr-only">{o.label} theme</span>
      <o.Icon className="size-4" aria-hidden="true" />
    </button>
  ))}
</div>
