---
/* The install command as the primary action: the pill IS the button. One click copies it; the
 * glyph turns into a check and a live region says "Copied" (scripts/copy.ts). */
import { Copy, Check } from "lucide-react";
import { installCommand } from "../../content/install";
interface Props { class?: string; command?: string; label?: string }
const { class: extra = "", command = installCommand, label = "Copy the install command" } = Astro.props;
---
<button type="button" class={`pill group inline-flex h-12 min-w-0 max-w-full items-center gap-3 rounded-full bg-primary pl-5 pr-4 text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 ${extra}`} data-copy={command} data-install aria-label={`${label}: ${command}`}>
  <code class="truncate font-mono text-sm font-medium before:mr-2 before:opacity-60 before:content-['$']">{command}</code>
  <span class="inline-flex size-6 items-center justify-center rounded-full bg-primary-foreground/15" aria-hidden="true">
    <Copy className="size-3.5 group-data-[done]:hidden" />
    <Check className="hidden size-3.5 group-data-[done]:block" />
  </span>
  <span class="sr-only" aria-live="polite" data-copy-label></span>
</button>
