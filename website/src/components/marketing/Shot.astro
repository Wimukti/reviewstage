---
/* Theme-aware screenshot in a panel frame. Renders a <picture> whose dark/light source
 * swaps with the site theme. Sources live in src/assets/screenshots/{name}-{dark,light}.png. */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { name: string; alt: string; label?: string; loading?: "eager" | "lazy"; }
const { name, alt, label = "reviewstage", loading = "lazy" } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>("../../assets/screenshots/*.png", { eager: true });
const pick = (theme: string) => all[`../../assets/screenshots/${name}-${theme}.png`]?.default;
const dark = pick("dark"), light = pick("light");
if (!dark || !light) throw new Error(`Missing screenshot pair for "${name}"`);
const d = await getImage({ src: dark, widths: [640, 960, 1280, 1600], format: "webp" });
const l = await getImage({ src: light, widths: [640, 960, 1280, 1600], format: "webp" });
---
<figure class="shot">
  <div class="shot-frame panel">
    <div class="shot-bar"><span class="shot-label">{label}</span><span class="shot-dot" aria-hidden="true"></span></div>
    <picture class="shot-dark">
      <source srcset={d.srcSet.attribute} sizes="(min-width: 72rem) 60rem, calc(100vw - 2rem)" type="image/webp" />
      <img src={d.src} alt={alt} width={dark.width} height={dark.height} loading={loading} decoding="async" />
    </picture>
    <picture class="shot-light">
      <source srcset={l.srcSet.attribute} sizes="(min-width: 72rem) 60rem, calc(100vw - 2rem)" type="image/webp" />
      <img src={l.src} alt={alt} width={light.width} height={light.height} loading={loading} decoding="async" />
    </picture>
  </div>
</figure>
<style>
  .shot { margin: 0; }
  .shot-frame { overflow: hidden; }
  .shot-bar { display: flex; align-items: center; justify-content: space-between; height: 2.4rem; padding-inline: 0.85rem; border-bottom: 1px solid var(--hairline); }
  .shot-label { color: var(--graphite); font-family: var(--mono); font-size: 0.8rem; }
  .shot-dot { width: 8px; height: 8px; border-radius: var(--r-full); background: var(--green); }
  picture { display: block; line-height: 0; }
  picture img { display: block; width: 100%; height: auto; }
  .shot-light { display: none; }
  :global(:root[data-theme="light"]) .shot-dark { display: none; }
  :global(:root[data-theme="light"]) .shot-light { display: block; }
</style>
