---
/* Proof page for design.md §7 and §9: the site renders the app's own PR page pieces, inside a
 * shadow root, from dashboard-ui/src. verify-site.mjs opens this page and asserts that the
 * island's shadow root contains a `.finding.is-staged`. Not for readers: noindex, out of the
 * sitemap. The W lane's hero and strip are the real placements of the same island. */
import MarketingLayout from "../layouts/MarketingLayout.astro";
import StageIsland from "../components/stage/StageIsland";
---
<MarketingLayout title="ReviewStage" description="Stage island proof page." noindex>
  <section class="container-page" style="padding-block: 3rem; display: grid; gap: 2rem;">
    <h1 class="section-title">Stage island proof</h1>
    <div class="stage-hero" data-proof="scene">
      <StageIsland client:only="react" scene="scene" state="staged" label="The PR page: two findings staged" />
    </div>
    <div data-proof="queue"><StageIsland client:only="react" scene="queue" state="new" /></div>
    <div data-proof="progress"><StageIsland client:only="react" scene="progress" cur={2} /></div>
    <div data-proof="play"><StageIsland client:only="react" scene="scene" state="staged" play /></div>
  </section>
</MarketingLayout>
