---
// "Who it's for": the three ways people run ReviewStage. Claims here must match what ships or
// is in flight this week; anything further out is labelled roadmap inline.
const tiers = [
  {
    t: "Solo",
    who: "One developer, one laptop",
    d: "Docker on your own machine. Paste a PR URL, get the findings, post the ones you stand behind.",
    points: [
      "docker compose up -d and you are in",
      "No notifications to configure; you open it when you review",
      "Runs on your own Claude plan, no shared key",
      "Add to Home Screen and it opens like an app",
    ],
  },
  {
    t: "Team",
    who: "One server, one repository",
    d: "A shared instance every reviewer signs in to. Within three minutes of a review request, the requested person gets a card.",
    points: [
      "Review-request alerts to Slack, Discord or any webhook",
      "Everyone signs in as themselves and posts as themselves",
      "Independent runs per reviewer; agreement across them is marked",
      "Skills, learnings and Insights shared by the team",
    ],
  },
  {
    t: "Company",
    who: "Many repositories, one install",
    d: "One server for the organisation: an allowlist of repositories, per-repo skills and risk paths, and Insights across all of them.",
    points: [
      "Multiple repositories per server",
      "Org membership allowlist for who may sign in",
      "Per-repo skills and risk paths",
      "Insights across repositories",
      { text: "GitHub App sign-in with central revocation", roadmap: true },
    ],
  },
];
---
<ul class="tiers">
  {tiers.map((tier) => (
    <li class="surface-card tier">
      <div class="tier-head">
        <h3 class="card-title">{tier.t}</h3>
        <p class="meta-text">{tier.who}</p>
      </div>
      <p class="body-text">{tier.d}</p>
      <ul class="tier-points">
        {tier.points.map((p) => typeof p === "string"
          ? <li>{p}</li>
          : <li>{p.text} <span class="badge roadmap">roadmap</span></li>)}
      </ul>
    </li>
  ))}
</ul>
<p class="body-text tiers-note">Same install, same gate at every size: nothing reaches GitHub without a signed-in person clicking, under their own name. Team and Company are configuration, not a different edition.</p>
<style>
  .tiers { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 48rem) { .tiers { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .tier { display: grid; gap: 0.9rem; padding: 1.5rem; align-content: start; }
  .tier-head { display: grid; gap: 0.2rem; }
  .tier-head .meta-text { margin: 0; }
  .tier-points { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; color: var(--muted-foreground); font-size: 0.925rem; line-height: 1.5; }
  .tier-points li { display: flex; gap: 0.6rem; align-items: baseline; }
  .tier-points li::before { content: ""; flex: none; width: 0.4rem; height: 0.4rem; border-radius: 999px; background: var(--primary); transform: translateY(-0.1rem); }
  .badge.roadmap { padding: 0.1rem 0.5rem; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .tiers-note { max-width: 46rem; }
</style>
