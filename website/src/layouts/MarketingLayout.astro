---
import SiteHeader from "../components/marketing/SiteHeader.astro";
import SiteFooter from "../components/marketing/SiteFooter.astro";
import "../styles/app.css";
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
const ld = {
  "@context": "https://schema.org", "@type": "SoftwareApplication", name: "ReviewStage", description,
  applicationCategory: "DeveloperApplication", operatingSystem: "Linux, macOS (Docker)",
  license: "https://opensource.org/license/mit", url: canonical, codeRepository: "https://github.com/Wimukti/reviewstage",
};
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F6F6F9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0B0C10" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/favicon-192.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}/favicon-512.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta property="og:site_name" content="ReviewStage" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      (() => {
        // Dark unless a choice is stored; "system" is stamped as itself (see scripts/theme.ts).
        let s = null; try { s = localStorage.getItem("starlight-theme"); } catch {}
        const pref = s === "light" || s === "dark" ? s : s === "auto" || s === "" ? "auto" : "dark";
        document.documentElement.dataset.theme = pref === "auto" ? "system" : pref;
        document.documentElement.dataset.themePreference = pref;
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <script>
      import { initTheme } from "../scripts/theme";
      initTheme();
    </script>
    <style>
      .skip-link { position: absolute; left: 50%; top: 0.5rem; z-index: 100; translate: -50% -200%; padding: 0.6rem 1rem; border: 1px solid var(--hairline); border-radius: var(--r-s); background: var(--panel); color: var(--ink); font-size: var(--t-14); font-weight: 500; text-decoration: none; }
      .skip-link:focus-visible { translate: -50% 0; }
    </style>
  </body>
</html>
