---
/* The hero's live simulated run: six panels that play the product story in sequence.
 * Pure DOM, driven by src/scripts/live-run.ts. Height is fixed per breakpoint so the
 * hero never reflows between steps. */
import { sev } from "./mocks/severity";
const steps = [
  { key: "Requested", caption: "Someone asks for your review. Nothing has run yet." },
  { key: "Run", caption: "Click-to-run, on your own Claude plan. Never automatic." },
  { key: "Drafting", caption: "Runs on your Claude subscription. Profiles critical paths." },
  { key: "Staged", caption: "Every finding is staged privately. Nothing is on GitHub." },
  { key: "Decide", caption: "Keep, edit, or drop. Your judgment, your words." },
  { key: "Posted", caption: "Posts under your own name. Never as a bot." },
];
const findings = [
  { sev: "high", title: "Retry can refund twice on a timed-out capture", why: "A gateway timeout is not a failure; the first attempt may have succeeded.", at: "payments/refunds/retry.ts:88", critical: true },
  { sev: "high", title: "Idempotency key is regenerated on every retry", why: "Each attempt looks new to the gateway, so its dedupe never fires.", at: "payments/refunds/client.ts:41" },
  { sev: "medium", title: "Backoff has no jitter", why: "Synchronised retries after an outage spike the gateway at once.", at: "payments/refunds/retry.ts:112" },
  { sev: "medium", title: "Timeout error is swallowed into a generic 500", why: "Ops cannot tell a slow gateway from a bug.", at: "payments/api/refund.ts:57" },
  { sev: "medium", title: "Test covers the happy path only", why: "No case for timed out, then succeeded.", at: "payments/refunds/retry.test.ts:19" },
  { sev: "low", title: "RETRY_LIMIT is a magic number", why: "Three lives in two files; name it once.", at: "payments/refunds/retry.ts:9" },
];
/* Step-5 acts on the finding rows, by index. */
const acts: Record<number, { t: number; act: string }> = {
  2: { t: 300, act: "untick" },
  4: { t: 1000, act: "untick" },
  0: { t: 1700, act: "edit" },
};
---
<figure class="lr" data-live-run data-step="1" aria-label="Simulated ReviewStage run">
  <div class="lr-frame">
    <div class="lr-bar">
      <span class="lr-chip"><span class="lr-live"><i aria-hidden="true"></i>Live</span>acme/payments #482</span>
      <span class="lr-counter" data-counter aria-live="polite">1 / 6</span>
    </div>
    <div class="lr-screen">
      <!-- 1 · Review requested -->
      <div class="lr-panel lr-p1" data-panel="1">
        <div class="lr-slack" data-t="60">
          <div class="lr-slack-app" aria-hidden="true">RS</div>
          <div class="lr-slack-body">
            <div class="lr-slack-head"><b>ReviewStage</b> <span class="lr-app">App</span> <span class="lr-dim">9:41</span></div>
            <p><b>@you</b> was requested to review <b>#482</b></p>
            <div class="lr-slack-att">
              <div class="lr-slack-title">Refund flow: retry on gateway timeout</div>
              <div class="lr-mono lr-dim">acme/payments · <span class="lr-add">+412</span> <span class="lr-del">−38</span> · 9 files</div>
              <span class="lr-btn lr-btn-ghost">Open in ReviewStage</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 2 · You choose the run -->
      <div class="lr-panel lr-p2" data-panel="2">
        <div class="lr-form">
          <div class="lr-field">
            <span class="lr-label">Effort</span>
            <div class="lr-seg">
              <span class="lr-seg-opt lr-seg-on">Quick</span>
              <span class="lr-seg-opt" data-t="520">Standard <span class="lr-auto" data-t="760" data-s="2">Suggested</span></span>
              <span class="lr-seg-opt">Deep</span>
            </div>
          </div>
          <div class="lr-field">
            <span class="lr-label">Model</span>
            <div class="lr-chips">
              <span class="lr-chip-opt">Default</span>
              <span class="lr-chip-opt">Opus</span>
              <span class="lr-chip-opt lr-chip-on">Sonnet</span>
              <span class="lr-chip-opt">Haiku</span>
            </div>
          </div>
          <div class="lr-field">
            <span class="lr-label">Focus <span class="lr-dim">(optional)</span></span>
            <div class="lr-input" data-t="900"><span data-type>check idempotency on retries</span><i class="lr-caret" aria-hidden="true"></i></div>
          </div>
          <div class="lr-form-foot">
            <span class="lr-dim">Billed to your plan · ~12 min</span>
            <span class="lr-btn lr-btn-primary" data-t="2300">Start review</span>
          </div>
        </div>
      </div>

      <!-- 3 · Drafting -->
      <div class="lr-panel lr-p3" data-panel="3">
        <div class="lr-run">
          <div class="lr-run-head">
            <span class="status is-amber"><i class="lr-run-dot" aria-hidden="true"></i>Drafting · standard · sonnet</span>
            <span class="lr-dim lr-mono">worktree rs-482</span>
          </div>
          <div class="lr-progress" aria-hidden="true"><i data-t="120"></i></div>
          <ol class="lr-log lr-mono">
            <li data-t="200"><span class="lr-dim">00:02</span> checked out worktree</li>
            <li data-t="700"><span class="lr-dim">00:05</span> reading 9 files</li>
            <li data-t="1200"><span class="lr-dim">00:41</span> walking critical path: <b>payments/refunds/**</b></li>
            <li data-t="1800"><span class="lr-dim">03:12</span> <b class="lr-ok">6 findings</b></li>
          </ol>
        </div>
      </div>

      <!-- 4 · Staged and 5 · You decide share one panel -->
      <div class="lr-panel lr-p4" data-panel="4 5">
        <div class="lr-fhead">
          <span><b>6 findings</b> staged</span>
          <span class="status"><i aria-hidden="true"></i>Private draft<span class="lr-editing"></span></span>
        </div>
        <ol class="lr-list" data-t="100" data-s="4">
          {findings.map((f, i) => (
            <li class="lr-finding" style={`--i:${i}`} data-t={acts[i]?.t} data-s={acts[i] ? 5 : undefined} data-act={acts[i]?.act}>
              <span class="lr-check" data-hit aria-hidden="true"></span>
              <div class="lr-fbody">
                <div class="lr-frow">
                  <span class={`status is-${sev(f.sev).tone}`}><i aria-hidden="true"></i>{sev(f.sev).word}</span>
                  <span class="lr-ftitle">{acts[i]?.act === "edit" ? <span data-edit="charge" data-cut="7">{f.title}</span> : f.title}</span>
                  {f.critical && <span class="status is-blue"><i aria-hidden="true"></i>Critical path</span>}
                </div>
                <div class="lr-fmeta"><span class="lr-fwhy">{f.why}</span><span class="lr-fat lr-mono">{f.at}</span></div>
              </div>
            </li>
          ))}
        </ol>
        <div class="lr-commit">
          <span class="lr-commit-left"><b><span data-count>6</span> staged</b><span class="lr-dim">· comment review</span></span>
          <span class="lr-btn lr-btn-primary lr-post" data-t="3000" data-s="5" data-act="press"><span>Post <b data-count>6</b> as you</span></span>
        </div>
      </div>

      <!-- 6 · Posted as you -->
      <div class="lr-panel lr-p6" data-panel="6">
        <div class="lr-gh" data-t="40">
          <div class="lr-gh-head">
            <span class="lr-avatar" aria-hidden="true">Y</span>
            <span><b>you</b> commented · 4 comments</span>
            <span class="status is-green"><i aria-hidden="true"></i>Comment</span>
          </div>
          <ul class="lr-gh-list">
            <li><span class="lr-mono lr-dim">retry.ts:88</span> Retry can refund twice on a timed-out charge</li>
            <li><span class="lr-mono lr-dim">client.ts:41</span> Idempotency key is regenerated on every retry</li>
            <li><span class="lr-mono lr-dim">refund.ts:57</span> Timeout error is swallowed into a generic 500</li>
            <li><span class="lr-mono lr-dim">retry.ts:9</span> RETRY_LIMIT is a magic number</li>
          </ul>
          <div class="lr-gh-foot">
            <span class="lr-dim">Approval is a separate click.</span>
            <span class="lr-btn lr-btn-ghost lr-approve">Approve</span>
          </div>
        </div>
        <div class="lr-toast status is-green" data-t="700" role="status"><i aria-hidden="true"></i>Posted as <b>@you</b> · comment review</div>
      </div>

      <span class="lr-cursor" aria-hidden="true"></span>
    </div>
  </div>

  <figcaption class="lr-foot">
    <div class="lr-caption">
      {steps.map((s, i) => <p data-caption hidden={i !== 0}>{s.caption}</p>)}
    </div>
    <div class="lr-steps" role="group" aria-label="Steps of the simulated run">
      {steps.map((s, i) => (
        <button type="button" class="lr-step" data-lr-step={i + 1} aria-current={i === 0 ? "step" : "false"} aria-pressed="false" tabindex={i === 0 ? 0 : -1}>
          <i aria-hidden="true"></i><span>{s.key}</span>
        </button>
      ))}
    </div>
  </figcaption>
</figure>

<style>
  .lr { --lr-h: 33rem; --lr-ease: var(--ease); margin: 0; display: grid; gap: 0.9rem; font-size: var(--t-13); line-height: 1.45; color: var(--ink); }
  .lr-frame { position: relative; border: 1px solid var(--hairline); border-radius: var(--r-m); background: var(--panel); overflow: hidden; }
  .lr-bar { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; height: 2.4rem; padding-inline: 0.85rem; border-bottom: 1px solid var(--hairline); }
  .lr-chip { display: inline-flex; align-items: center; gap: 0.6rem; min-width: 0; color: var(--graphite); font-family: var(--mono); font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lr-live { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--green); font-family: var(--font); font-weight: 500; }
  .lr-live i { width: 8px; height: 8px; border-radius: var(--r-full); background: var(--green); animation: lr-pulse 1.6s ease-in-out infinite; }
  @keyframes lr-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
  .lr-counter { flex: none; white-space: nowrap; color: var(--graphite); font-family: var(--mono); font-size: 0.8rem; font-variant-numeric: tabular-nums; }

  .lr-screen { position: relative; height: var(--lr-h); overflow: hidden; background: var(--paper); }
  .lr-panel { position: absolute; inset: 0; padding: 1rem; display: grid; align-content: start; gap: 0.75rem; opacity: 0; translate: 0 0.5rem; visibility: hidden; transition: opacity 320ms var(--lr-ease), translate 320ms var(--lr-ease), visibility 0s 320ms; }
  .lr-panel.active { opacity: 1; translate: 0 0; visibility: visible; transition-delay: 0s; }

  .lr-mono { font-family: var(--mono); font-size: 0.86em; }
  .lr-dim { color: var(--graphite); }
  .lr-add { color: var(--green); } .lr-del { color: var(--red); } .lr-ok { color: var(--green); }
  .lr-btn { display: inline-flex; align-items: center; justify-content: center; height: 30px; padding-inline: 0.75rem; border: 1px solid var(--hairline); border-radius: var(--r-s); background: var(--panel); color: var(--ink); font-weight: 500; font-size: var(--t-13); white-space: nowrap; }
  .lr-btn-ghost { color: var(--ink); }
  .lr-btn-primary { border-color: var(--blue); background: var(--blue); color: var(--blue-ink); }
  .lr-card { border: 1px solid var(--hairline); border-radius: var(--r-m); background: var(--panel); }

  /* 1 · Slack card */
  .lr-p1 { align-content: center; }
  .lr-slack { display: grid; grid-template-columns: 2.25rem 1fr; gap: 0.7rem; padding: 0.9rem; border: 1px solid var(--hairline); border-radius: var(--r-m); background: var(--panel); opacity: 0; translate: 0 1rem; transition: opacity 420ms var(--lr-ease), translate 520ms var(--lr-ease); }
  .lr-slack.in { opacity: 1; translate: 0 0; }
  .lr-slack-app { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: var(--r-s); background: var(--ink); color: var(--paper); font-weight: 600; font-size: 0.8rem; }
  .lr-slack-body { display: grid; gap: 0.3rem; min-width: 0; }
  .lr-slack-body p { margin: 0; }
  .lr-slack-head { display: flex; align-items: baseline; gap: 0.4rem; }
  .lr-app { padding: 0 0.3rem; border-radius: var(--r-s); background: var(--paper); border: 1px solid var(--hairline); color: var(--graphite); font-size: 0.72rem; font-weight: 500; }
  .lr-slack-att { display: grid; gap: 0.35rem; margin-top: 0.3rem; padding: 0.55rem 0.75rem; border-radius: var(--r-s); background: var(--paper); box-shadow: inset 3px 0 0 var(--hairline); }
  .lr-slack-title { font-weight: 600; }
  .lr-slack-att .lr-btn { justify-self: start; margin-top: 0.2rem; }

  /* 2 · Run form */
  .lr-form { display: grid; gap: 0.85rem; padding: 0.9rem; border: 1px solid var(--hairline); border-radius: var(--r-m); background: var(--panel); }
  .lr-field { display: grid; gap: 0.35rem; }
  .lr-label { display: flex; justify-content: space-between; color: var(--graphite); font-size: var(--t-13); font-weight: 500; }
  .lr-seg { display: grid; grid-template-columns: repeat(3, 1fr); padding: 2px; border: 1px solid var(--hairline); border-radius: var(--r-s); background: var(--paper); }
  .lr-seg-opt { position: relative; display: flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 28px; border-radius: var(--r-s); color: var(--graphite); font-weight: 500; transition: background-color 260ms var(--lr-ease), color 260ms var(--lr-ease); }
  .lr-seg-opt.in, .lr-seg-on { background: var(--panel); color: var(--ink); box-shadow: 0 0 0 1px var(--hairline); }
  .lr-seg:has(.in) .lr-seg-on { background: transparent; color: var(--graphite); box-shadow: none; }
  .lr-auto { position: absolute; top: -0.75rem; right: -0.25rem; padding: 0 0.35rem; border-radius: var(--r-s); background: var(--blue); color: var(--blue-ink); font-size: 0.68rem; font-weight: 500; line-height: 1.5; opacity: 0; transition: opacity 240ms var(--lr-ease); }
  .lr-auto.in { opacity: 1; }
  .lr-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .lr-chip-opt { padding: 0.15rem 0.6rem; border: 1px solid var(--hairline); border-radius: var(--r-s); background: var(--panel); color: var(--graphite); }
  .lr-chip-on { border-color: var(--blue); background: var(--blue-bg); color: var(--ink); }
  .lr-input { display: flex; align-items: center; min-height: 32px; padding: 0.35rem 0.6rem; border: 1px solid var(--hairline); border-radius: var(--r-s); background: var(--paper); font-family: var(--mono); font-size: 0.86em; }
  .lr-input.in { outline: 2px solid var(--blue); outline-offset: 2px; }
  .lr-caret { width: 1px; height: 1em; margin-left: 1px; background: var(--ink); opacity: 0; }
  .lr-input.in .lr-caret { animation: lr-blink 1s steps(2) infinite; }
  @keyframes lr-blink { to { opacity: 1; } }
  .lr-form-foot { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .lr-form-foot .lr-btn-primary { opacity: 0.5; transition: opacity 260ms var(--lr-ease); }
  .lr-form-foot .lr-btn-primary.in { opacity: 1; }

  /* 3 · Drafting */
  .lr-run { display: grid; gap: 0.75rem; padding: 0.9rem; border: 1px solid var(--hairline); border-radius: var(--r-m); background: var(--panel); }
  .lr-run-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; font-weight: 600; }
  .lr-run-dot { animation: lr-pulse 1.6s ease-in-out infinite; }
  .lr-progress { height: 4px; border-radius: var(--r-s); background: var(--hairline); overflow: hidden; }
  .lr-progress i { display: block; height: 100%; width: 4%; background: var(--blue); transition: width 2200ms var(--lr-ease); }
  .lr-progress i.in { width: 92%; }
  .lr-log { display: grid; gap: 0.3rem; margin: 0; padding: 0.6rem 0.7rem; list-style: none; border: 1px solid var(--hairline); border-radius: var(--r-s); background: var(--paper); }
  .lr-log li { opacity: 0; translate: -0.35rem 0; transition: opacity 260ms var(--lr-ease), translate 320ms var(--lr-ease); }
  .lr-log li.in { opacity: 1; translate: 0 0; }
  .lr-log .lr-dim { margin-right: 0.5rem; }

  /* 4 + 5 · Findings */
  .lr-p4 { gap: 0.6rem; grid-template-rows: auto 1fr auto; }
  .lr-fhead { display: flex; align-items: center; justify-content: space-between; }
  .lr-list { display: grid; margin: 0; padding: 0; list-style: none; align-content: start; min-height: 0; overflow: hidden; border: 1px solid var(--hairline); border-radius: var(--r-m); background: var(--panel); }
  .lr-finding { display: grid; grid-template-columns: 14px 1fr; gap: 0.6rem; align-items: start; padding: 0.5rem 0.75rem; box-shadow: inset 3px 0 0 var(--blue); opacity: 0; translate: 0 0.5rem; transition: opacity 320ms var(--lr-ease), translate 420ms var(--lr-ease), box-shadow var(--dur) var(--ease); }
  .lr-finding + .lr-finding { border-top: 1px solid var(--hairline); }
  .lr-list.in .lr-finding { opacity: 1; translate: 0 0; transition-delay: calc(var(--i) * 90ms), calc(var(--i) * 90ms), 0s; }
  .lr-finding.off { box-shadow: inset 0 0 0 var(--blue); color: var(--graphite); transition-delay: 0s; }
  .lr-finding.off .lr-ftitle { font-weight: 500; }
  .lr-finding.off .lr-check { background: transparent; border-color: var(--hairline); }
  .lr-finding.off .lr-check::after { opacity: 0; }
  .lr-finding.open { background: var(--blue-bg); }
  .lr-finding.open [data-edit] { border-bottom: 1px dashed var(--blue); }
  .lr-check { position: relative; width: 14px; height: 14px; margin-top: 0.15rem; border: 1px solid var(--blue); border-radius: var(--r-s); background: var(--blue); transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .lr-check::after { content: ""; position: absolute; left: 4px; top: 1px; width: 4px; height: 8px; border: solid var(--blue-ink); border-width: 0 2px 2px 0; rotate: 45deg; transition: opacity var(--dur); }
  .lr-fbody { display: grid; gap: 0.05rem; min-width: 0; }
  .lr-fmeta { display: flex; gap: 0.6rem; align-items: baseline; min-width: 0; }
  .lr-fwhy { flex: 1 1 auto; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .lr-fat { flex: none; }
  .lr-frow { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .lr-ftitle { font-weight: 600; }
  .lr-fwhy { color: var(--graphite); }
  .lr-fat { color: var(--graphite); }
  .lr-commit { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.6rem 0.85rem; border-radius: var(--r-m); background: var(--raised); box-shadow: var(--shadow-raised); }
  .lr-commit-left { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.5rem; }
  .lr-commit-left b { font-weight: 600; }
  .lr-post { opacity: 0.5; transition: opacity 260ms var(--lr-ease); }
  .lr-post.in { opacity: 1; }
  .lr[data-step="5"] .lr-editing::after { content: " · editing"; }

  /* 6 · GitHub review */
  .lr-p6 { align-content: center; }
  .lr-gh { display: grid; gap: 0.7rem; padding: 0.9rem; border: 1px solid var(--hairline); border-radius: var(--r-m); background: var(--panel); opacity: 0; translate: 0 0.75rem; transition: opacity 380ms var(--lr-ease), translate 420ms var(--lr-ease); }
  .lr-gh.in { opacity: 1; translate: 0 0; }
  .lr-gh-head { display: flex; align-items: center; gap: 0.55rem; }
  .lr-gh-head .status { margin-left: auto; }
  .lr-avatar { display: grid; place-items: center; width: 22px; height: 22px; border-radius: var(--r-full); background: var(--ink); color: var(--paper); font-weight: 600; font-size: 0.72rem; }
  .lr-gh-list { display: grid; margin: 0; padding: 0; list-style: none; border: 1px solid var(--hairline); border-radius: var(--r-s); background: var(--paper); }
  .lr-gh-list li { display: flex; gap: 0.6rem; align-items: baseline; padding: 0.4rem 0.6rem; }
  .lr-gh-list li + li { border-top: 1px solid var(--hairline); }
  .lr-gh-list .lr-mono { flex: 0 0 auto; }
  .lr-gh-foot { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding-top: 0.6rem; border-top: 1px solid var(--hairline); }
  .lr-toast { position: absolute; right: 1rem; bottom: 1rem; padding: 0.5rem 0.75rem; border: 1px solid var(--hairline); border-radius: var(--r-s); background: var(--panel); opacity: 0; translate: 0 0.75rem; transition: opacity 260ms var(--lr-ease), translate 380ms var(--lr-ease); }
  .lr-toast.in { opacity: 1; translate: 0 0; }

  /* Cursor dot */
  .lr-cursor { position: absolute; left: 0; top: 0; z-index: 5; width: 14px; height: 14px; margin: -7px; border-radius: var(--r-full); background: var(--blue); opacity: 0; pointer-events: none; transition: translate 380ms var(--lr-ease), opacity 200ms; }
  .lr-cursor.show { opacity: 0.6; }

  /* Caption and stepper */
  .lr-foot { display: grid; gap: 0.6rem; }
  .lr-caption { min-height: 3em; color: var(--graphite); font-size: var(--t-14); line-height: 1.5; text-wrap: pretty; }
  .lr-caption p { margin: 0; }
  .lr-steps { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.25rem; }
  .lr-step { display: grid; gap: 0.4rem; min-height: 44px; padding: 0.4rem 0.2rem; border: 0; border-radius: var(--r-s); background: transparent; color: var(--graphite); font: inherit; font-size: var(--t-13); font-weight: 500; cursor: pointer; text-align: center; transition: color 200ms var(--lr-ease); }
  .lr-step i { display: block; height: 2px; background: var(--hairline); transition: background-color 260ms var(--lr-ease); }
  .lr-step:hover { color: var(--ink); }
  .lr-step[aria-current="step"] { color: var(--ink); }
  .lr-step[aria-current="step"] i { background: var(--blue); }
  .lr-step[aria-pressed="true"] i { height: 3px; }
  .lr[data-pinned="true"] .lr-counter::after { content: " · pinned"; }
  .lr[data-reduced="true"] :is(.lr-live i, .lr-run-dot) { animation: none; }

  @media (max-width: 30rem) {
    .lr { --lr-h: 25rem; }
    .lr-finding:nth-child(n + 4) { display: none; }
    .lr-panel { padding: 0.75rem; }
    .lr-fwhy { display: none; }
    .lr-live { display: none; }
    .lr-step span { font-size: 0.8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
