---
/* Panel frame for a static DOM mock: mono label, green dot, then the slot. */
interface Props { label: string; right?: string; }
const { label, right } = Astro.props;
---
<figure class="mk">
  <div class="mk-frame">
    <div class="mk-bar">
      <span class="mk-chip"><span class="mk-dot" aria-hidden="true"></span>{label}</span>
      {right && <span class="mk-chip mk-right">{right}</span>}
    </div>
    <div class="mk-screen"><slot /></div>
  </div>
</figure>
<style>
  .mk-right { flex: none; }
</style>
