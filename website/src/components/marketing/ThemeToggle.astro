---
/* Three-way segmented control: light, dark, system. Wired by scripts/theme.ts. */
const options = [
  { value: "light", label: "Light" },
  { value: "dark", label: "Dark" },
  { value: "auto", label: "System" },
] as const;
---
<div class="theme-switch" data-theme-switch role="group" aria-label="Color theme">
  {options.map((o) => (
    <button type="button" class="option" data-theme-option={o.value} aria-pressed="false" title={`${o.label} theme`}>
      <span class="sr-only">{o.label} theme</span>
      {o.value === "light" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>}
      {o.value === "dark" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>}
      {o.value === "auto" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/></svg>}
    </button>
  ))}
</div>
<style>
  .theme-switch { display: inline-flex; align-items: center; gap: 2px; padding: 2px; border: 1px solid var(--hairline); border-radius: var(--r-s); background-color: var(--paper); }
  .option { display: grid; place-items: center; width: 30px; height: 30px; border: 0; border-radius: var(--r-s); background: transparent; color: var(--graphite); cursor: pointer; }
  .option svg { width: 15px; height: 15px; }
  .option:hover { color: var(--ink); }
  .option[aria-pressed="true"] { background: var(--panel); color: var(--ink); box-shadow: 0 0 0 1px var(--hairline); }
  @media (max-width: 40rem) { .option { width: 44px; height: 44px; } }
</style>
