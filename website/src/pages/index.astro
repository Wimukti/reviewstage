---
/* Home: four sections, under 400 words (design §9). The fold and the strip are the app's own
 * components (design §7); everything a reader might want to know beyond this lives in the docs. */
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Hero from "../components/marketing/Hero.astro";
import HowItWorks from "../components/marketing/HowItWorks";
import Guarantees from "../components/marketing/Guarantees.astro";
import Install from "../components/marketing/Install.astro";

const title = "ReviewStage";
const description =
  "ReviewStage drafts your PR review from the real diff, on your own Claude plan, and stages every finding privately. Nothing posts until you click.";
---
<MarketingLayout {title} {description}>
  <Hero />

  <section id="how-it-works" class="home-section" aria-labelledby="how-title">
    <div class="container-page section-inner">
      <h2 id="how-title" class="section-title">How it works</h2>
      <div class="how-slot"><HowItWorks client:only="react" /></div>
    </div>
  </section>

  <section id="guarantees" class="home-section" aria-labelledby="guarantees-title">
    <div class="container-page section-inner">
      <h2 id="guarantees-title" class="section-title">What holds, always</h2>
      <Guarantees />
    </div>
  </section>

  <section id="install" class="home-section" aria-labelledby="install-title">
    <div class="container-page section-inner">
      <h2 id="install-title" class="section-title">Install</h2>
      <Install />
    </div>
  </section>
</MarketingLayout>
<style>
  .home-section { padding-block: var(--section-pad); scroll-margin-top: calc(var(--nav-height) + 1rem); }
  .section-inner { display: grid; gap: var(--section-gap); }
  /* The strip is a client-only island; its slot is reserved at the mounted height per width so
     the sections below it do not shift when it arrives (Lighthouse CLS). */
  .how-slot { min-height: 860px; }
  @media (max-width: 64rem) { .how-slot { min-height: 880px; } }
  @media (max-width: 40rem) { .how-slot { min-height: 1200px; } }
</style>
