---
const items = ["Open source (MIT)", "Self-hosted", "Human-gated", "Runs on your Claude subscription", "Never posts as a bot"];
---
<div class="trust">
  <div class="container-page">
    <ul>{items.map((t) => <li class="status is-green"><i aria-hidden="true"></i>{t}</li>)}</ul>
  </div>
</div>
<style>
  .trust { border-bottom: 1px solid var(--hairline); }
  ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 2rem; margin: 0; padding: 1rem 0; list-style: none; }
  li.status { color: var(--graphite); font-weight: 500; }
</style>
