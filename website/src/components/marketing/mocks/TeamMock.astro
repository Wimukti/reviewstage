---
/* Team mode: the shared queue, two repositories, two reviewers with their own runs. */
import MockFrame from "./MockFrame.astro";
import { sev } from "./severity";
const rows = [
  { n: 482, t: "Refund flow: retry on gateway timeout", repo: "payments", by: "mira", size: "+412 −38", sev: ["high", "medium"], who: ["a", "b"] },
  { n: 479, t: "Cut-off check in the customer's timezone", repo: "web", by: "dev-bot", size: "+96 −12", sev: ["medium"], who: ["a"] },
  { n: 477, t: "Stacked: extract RefundGateway (2 of 3)", repo: "payments", by: "jon", size: "+220 −140", sev: [], who: ["b"] },
  { n: 475, t: "Bump pnpm and lockfile", repo: "web", by: "renovate", size: "+8 −8", sev: ["low"], who: [] },
];
---
<MockFrame label="queue · acme · 2 repositories" right="you · mira">
  <div class="mk-tabs">
    <span class="mk-tab mk-tab-on">To review<span class="mk-n">4</span></span>
    <span class="mk-tab">Reviewed<span class="mk-n">2</span></span>
    <span class="mk-tab">Posted<span class="mk-n">7</span></span>
    <span class="mk-tab">Approved<span class="mk-n">3</span></span>
  </div>
  <div class="mk-chips">
    <span class="mk-chip-opt mk-chip-on">acme/payments</span>
    <span class="mk-chip-opt mk-chip-on">acme/web</span>
    <span class="mk-chip-opt">+ Add repository</span>
  </div>
  <ul class="mk-list">
    {rows.map((r) => (
      <li class="mk-row q">
        <span class="mk-mono mk-dim">#{r.n}</span>
        <div>
          <div class="mk-line">
            <span class="mk-title">{r.t}</span>
            {r.sev.map((s) => <span class={`status is-${sev(s).tone}`}><i aria-hidden="true"></i>{sev(s).word}</span>)}
          </div>
          <div class="mk-meta">
            <span>acme/{r.repo} · by {r.by}</span>
            <span class="mk-mono">{r.size}</span>
            <span class="mk-mono">requested 09/12/26</span>
          </div>
        </div>
        <span class="mk-avatars" aria-label="Reviewers with their own run">
          {r.who.map((w) => <span class={`mk-avatar mk-avatar-${w}`}>{w === "a" ? "Y" : "M"}</span>)}
          {r.who.length === 0 && <span class="mk-dim">No run yet</span>}
        </span>
      </li>
    ))}
  </ul>
  <div class="mk-h">
    <span class="mk-dim">Each reviewer's run, post and approval carries their own GitHub identity.</span>
  </div>
</MockFrame>
<style>
  .q { grid-template-columns: auto 1fr auto; align-items: center; }
</style>
