---
/* The fold (proposal §"Home" 1): two lines, one sentence, two buttons, then the real PR page
 * playing the staging sequence under the stage light. Nothing else is above the frame. */
import HeroStage from "./HeroStage";
import GitHubIcon from "./GitHubIcon.astro";
import { installCommand } from "../../content/install";
import { repo } from "../../content/site-links";
---
<section class="hero">
  <div class="container-page hero-copy">
    <h1 class="display-title">AI wrote the PR.<br /><span class="accent">You still have to review it.</span></h1>
    <p class="hero-line">Stage every finding privately. Post the ones you mean, as yourself.</p>
    <div class="hero-actions">
      <button type="button" class="btn btn-primary" data-copy={installCommand} aria-label="Copy the one-line install command">
        <span data-copy-label>Install</span>
      </button>
      <a class="btn btn-secondary" href={repo}><GitHubIcon />GitHub</a>
    </div>
  </div>
  <div class="container-page hero-stage stage-hero">
    <HeroStage client:only="react" />
  </div>
</section>
<style>
  /* overflow-x: clip keeps the light's 140%-wide gradient from widening the page on a phone without
     making the section a scroll container. */
  .hero { padding-block: clamp(3rem, 7vw, 6rem) var(--section-pad); border-bottom: 1px solid var(--hairline); overflow-x: clip; }
  .hero-copy { display: grid; justify-items: center; gap: 1.5rem; text-align: center; }
  .hero-line { margin: 0; max-width: 40rem; color: var(--graphite); font-size: var(--t-16); line-height: 1.5; text-wrap: balance; }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .hero-actions .btn-primary { min-width: 8rem; }
  .hero-stage { margin-top: clamp(2.5rem, 5vw, 4rem); }
  /* The island renders client-only; the reserved height keeps the fold from jumping when it mounts. */
  .hero-stage :global([data-hero-stage]) { min-height: 34rem; }
  @media (max-width: 40rem) { .hero-stage :global([data-hero-stage]) { min-height: 40rem; } }
</style>
