---
/* The site's chrome, on the system (design §2): a canvas-toned bar with one divider under it,
 * sans links, a ghost GitHub button and the one filled action. The phone menu is a popover card. */
import { Menu } from "lucide-react";
import Mark from "./Mark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import GitHubIcon from "./GitHubIcon.astro";
import { button } from "./variants";
import { navLinks, repo, withBase } from "../../content/site-links";
---
<header class="site-header sticky top-0 z-50 border-b bg-background/90 backdrop-blur">
  <div class="container-page flex h-[var(--nav-height)] items-center gap-4">
    <a class="inline-flex min-h-11 items-center gap-2.5 text-base font-semibold tracking-tight text-foreground no-underline" href={withBase("/")} aria-label="ReviewStage home">
      <Mark size={22} />
      <span>ReviewStage</span>
    </a>
    <nav class="ml-6 hidden items-center gap-1 lg:flex" aria-label="Primary">
      {navLinks.map((l) => <a class={button({ variant: "ghost", size: "sm" }, "text-muted-foreground hover:text-foreground")} href={withBase(l.href)}>{l.label}</a>)}
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <ThemeToggle />
      <a class={button({ variant: "ghost", size: "sm" }, "hidden text-muted-foreground hover:text-foreground sm:inline-flex")} href={repo} aria-label="ReviewStage on GitHub">
        <GitHubIcon />
        GitHub
      </a>
      <a class={button({ size: "sm" }, "hidden sm:inline-flex")} href={withBase("/start/")}>Get started</a>
      <details class="mobile-menu relative lg:hidden">
        <summary class={button({ variant: "secondary", size: "icon-sm" }, "list-none max-sm:size-11")} aria-label="Toggle navigation menu">
          <Menu className="size-4" aria-hidden="true" />
        </summary>
        <div class="absolute right-0 top-[calc(100%+0.5rem)] grid min-w-[13rem] rounded-lg bg-popover p-1 text-popover-foreground shadow-xl">
          {navLinks.map((l) => <a class="flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-foreground no-underline hover:bg-accent" href={withBase(l.href)}>{l.label}</a>)}
          <a class="flex min-h-11 items-center gap-2 rounded-md px-3 text-sm font-medium text-foreground no-underline hover:bg-accent" href={repo}><GitHubIcon />GitHub</a>
          <a class="mt-1 flex min-h-11 items-center rounded-md border-t px-3 text-sm font-medium text-primary no-underline hover:bg-accent sm:hidden" href={withBase("/start/")}>Get started</a>
        </div>
      </details>
    </div>
  </div>
</header>
<style>
  .mobile-menu summary::-webkit-details-marker { display: none; }
</style>
