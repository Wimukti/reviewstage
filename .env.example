# ReviewStage — Docker configuration. Copy to .env, fill in the first two, `docker compose up -d`.
#
# These reach the container as environment variables and are mirrored into the data volume's
# .env on every start, so editing this file + `docker compose up -d` is all a change needs.
# (The dashboard reads .env once, at startup — `docker compose up -d` recreates it.)
#
# To publish the dashboard on a different HOST port, set RS_HOST_PORT below. Do NOT set
# RS_PORT: the container's listen port is pinned to 8899 in docker-compose.yml because it is
# part of the image contract (EXPOSE, the healthcheck, the publish target), and an RS_PORT here
# would only move the server away from the port the publish still targets.
#
# Diagnostics: `docker compose exec app doctor` (inside the container — on the host the script
# reads the wrong .env and finds none of the CLIs).

# The repositories to review, as owner/name, comma-separated. One install reviews many repos.
# (REPO=owner/name still works as a single-entry alias.)
REPOS=your-org/your-repo,your-org/another-repo

# Optional: also accept any repo under this org where a signed-in user gets a review request
# (discovered by the poller, cloned on first review). The service token must see the org.
REPO_ALLOW_ORG=

# The SERVICE token: reads PR metadata and diffs, clones the repo, runs the poller's searches.
# It never posts — comments and approvals use each signed-in reviewer's own token.
# Fine-grained PAT: Repository access = every repo above (or "All repositories" in the org when
# using REPO_ALLOW_ORG); Permissions = Pull requests: Read and write, Contents: Read,
# Metadata: Read. (docs/INSTALL-DOCKER.md)
GITHUB_PAT=

# 1 = everything works but nothing is written to GitHub. Ships as 1 on purpose; flip to 0
# after you have compared a few dry runs by hand. Read the security model before you do:
# https://wimukti.github.io/reviewstage/security/
DRY_RUN=1

# Refuse to start a review below this much AVAILABLE RAM, in MB. Read from the container's own
# cgroup budget, not the host's /proc/meminfo. A 1 GB host cannot run a review at the default;
# give the machine at least 2 GB rather than lowering this.
MIN_FREE_MB=800

# Refuse to start a review or a QA guide below this much free disk on the data volume, in MB.
# A full volume used to look like a successful review with an empty result.
MIN_FREE_DISK_MB=500

# Optional. How long per-run artefacts (agent logs, and whole history/<ts>/ run snapshots) and
# the poller's own logs are kept before the once-a-day sweep deletes them. Days. The newest 5
# runs per PR per reviewer survive the sweep however old they are.
RS_RETENTION_DAYS=30

# Optional. Skip bot-authored PRs (default 0) and ignore review requests on PRs older than this
# many days (default 45). Both are also switchable live from the dashboard's Settings page.
SKIP_BOT_PRS=0
RS_MAX_PR_AGE_DAYS=45

# The host port Compose publishes the dashboard on, as 127.0.0.1:<port>. The container always
# listens on 8899; this only changes where that is published. Default 8899.
RS_HOST_PORT=8899

# The URL people open. Slack buttons and the GitHub OAuth callback are built from it.
# Plain http is fine for localhost only; anything remote goes behind TLS (deploy/README.md).
# The Secure cookie flag is dropped only for a genuinely loopback PUBLIC_URL, so a real
# hostname served over plain http still gets Secure cookies (and a log line saying so).
PUBLIC_URL=http://localhost:8899

# Optional. Where cards go: a Slack incoming webhook, a Discord channel webhook, and/or any
# JSON endpoint (Teams, Zapier, n8n, …). Leave all empty and the dashboard is the inbox.
SLACK_WEBHOOK=
DISCORD_WEBHOOK=
WEBHOOK_URL=
# Optional. Signs generic-webhook requests (X-ReviewStage-Signature: sha256=<hmac>).
WEBHOOK_SECRET=
# Optional. slack,discord,generic or none. Empty = whichever URLs above are set. Also
# switchable live from the dashboard's Settings page, along with the poll interval — the
# interval is no longer an .env key.
NOTIFY_BACKENDS=

# Optional. GitHub webhook secret: with it set, a review request reaches the dashboard and
# Slack within a second instead of on the next poll. Same value goes into the GitHub webhook
# form (payload URL <PUBLIC_URL>/webhooks/github, events: Pull requests, Pull request reviews).
# Empty = polling only. docs/INSTALL-DOCKER.md#instant-updates-github-webhooks
GITHUB_WEBHOOK_SECRET=

# Sign in with GitHub works out of the box through GitHub's device flow: the login page shows a
# short code to enter at github.com/login/device. It uses a shared PUBLIC client ID (device
# flow has no secret and no callback; the token goes from GitHub straight to this server).
# GH_DEVICE_FLOW=0 turns it off; GH_DEVICE_CLIENT_ID swaps in your own device-flow-enabled app.
GH_DEVICE_FLOW=1
GH_DEVICE_CLIENT_ID=
# Optional. One-click redirect sign-in under your own OAuth App / GitHub App identity
# (callback <PUBLIC_URL>/oauth/callback). docs/SETUP.md "GitHub login".
GH_CLIENT_ID=
GH_CLIENT_SECRET=
GH_OAUTH_SCOPES=

# Signs dashboard links and encrypts stored tokens. Leave empty and the container generates
# one on first start and keeps it on the volume. Rotating it signs everyone out and
# invalidates outstanding Slack links.
RS_SECRET=
