---
/* Proposal §"Home" 4: the command, three steps as three lines, three quiet tier cards with one
 * line each, and the two closing links. This is the page's last section. */
import { Building2, ClipboardPaste, Container, LogIn, User, Users } from "lucide-react";
import InstallCommand from "./InstallCommand.astro";
import GitHubIcon from "./GitHubIcon.astro";
import { button } from "./variants";
import { repo, withBase } from "../../content/site-links";
const steps = [
  { Icon: Container, t: "Bring it up", d: "docker compose up -d, then open localhost:8899" },
  { Icon: LogIn, t: "Sign in as yourself", d: "GitHub device flow, then connect Claude" },
  { Icon: ClipboardPaste, t: "Paste a PR", d: "pick an effort, run, tick, post" },
];
const tiers = [
  { Icon: User, t: "Solo", d: "Your laptop, your PRs, your plan.", href: "/start/install/" },
  { Icon: Users, t: "Team", d: "One server, every reviewer as themselves.", href: "/start/team-mode/" },
  { Icon: Building2, t: "Company", d: "Many repositories, one allowlist, shared Insights.", href: "/start/team-mode/#many-repositories" },
];
---
<div class="grid gap-8">
  <div class="install-frame lift grid gap-5 rounded-lg bg-card p-4 text-card-foreground shadow-sm">
    <InstallCommand />
    <ol class="m-0 grid list-none gap-1.5 p-0">
      {steps.map((s, i) => (
        <li class="grid min-h-8 grid-cols-[auto_auto_1fr] items-center gap-3 text-sm max-sm:grid-cols-[auto_1fr]">
          <span class="inline-flex size-7 items-center justify-center rounded-md bg-muted text-primary" aria-hidden="true"><s.Icon className="size-4" /></span>
          <span class="font-medium"><span class="sr-only">Step {i + 1}: </span>{s.t}</span>
          <span class="text-muted-foreground max-sm:col-start-2">{s.d}</span>
        </li>
      ))}
    </ol>
  </div>
  <ul class="m-0 grid list-none gap-3 p-0 md:grid-cols-3">
    {tiers.map((t) => (
      <li>
        <a class="tier flex min-h-11 items-start gap-3 rounded-lg bg-card p-4 text-card-foreground no-underline shadow-sm transition-colors hover:bg-accent/40" href={withBase(t.href)}>
          <span class="mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-md bg-muted text-primary" aria-hidden="true"><t.Icon className="size-4" /></span>
          <span class="grid gap-0.5"><span class="text-sm font-medium">{t.t}</span><span class="text-sm text-muted-foreground">{t.d}</span></span>
        </a>
      </li>
    ))}
  </ul>
  <div class="flex flex-wrap gap-3">
    <a class={button({}, "max-sm:h-11")} href={withBase("/start/install/")}>Install guide</a>
    <a class={button({ variant: "secondary" }, "max-sm:h-11")} href={repo}><GitHubIcon />Star on GitHub</a>
  </div>
</div>
