---
/* Proposal §"Home" 3: five lines, no paragraphs — each a glyph and a sentence, StatusBadge
 * style, and each the link to the docs page that proves it. */
import { CreditCard, HardDrive, MessageSquare, MousePointerClick, UserCheck } from "lucide-react";
import { withBase } from "../../content/site-links";
const lines = [
  { Icon: UserCheck, t: "Your name on every comment, never a bot", href: "/security/#controls" },
  { Icon: MousePointerClick, t: "Nothing automatic: every review is a click", href: "/start/#what-it-deliberately-does-not-do" },
  { Icon: MessageSquare, t: "Comments, not blocks: it never requests changes", href: "/guides/reviewing/#posting" },
  { Icon: CreditCard, t: "Your Claude account pays for your runs", href: "/security/#claude-tokens" },
  { Icon: HardDrive, t: "Your box, your data: files, no database", href: "/security/#what-is-stored-and-how" },
];
---
<ul class="m-0 grid list-none gap-1 p-0 lg:grid-cols-2 lg:gap-x-12" aria-label="Guarantees">
  {lines.map((l) => (
    <li>
      <a class="guarantee -mx-3 flex min-h-11 items-center gap-3 rounded-md px-3 text-base font-medium text-foreground no-underline transition-colors hover:bg-accent/60" href={withBase(l.href)}>
        <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-md bg-muted text-primary" aria-hidden="true"><l.Icon className="size-4" /></span>
        <span>{l.t}</span>
      </a>
    </li>
  ))}
</ul>
