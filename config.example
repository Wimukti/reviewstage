# config.example — the shape of ~/.reviewstage/.env on your server.
#
# You do NOT copy this file anywhere. `bootstrap.sh` creates the real .env, prompts for the
# per-install values, and only ever ADDS missing keys — so your edits survive a re-run.
# This file exists so you can see every knob in one place before you start.
#
# The real file is chmod 600 and lives in $HOME, outside any deploy or sync target, so a
# redeploy cannot delete it and it never reaches a git repo.
#
# Per-person data (each teammate's encrypted token + Slack member ID) is NOT here — it is in
# ~/.reviewstage/users.json, written by the dashboard when they sign in.

# --- secrets you paste in yourself (bootstrap leaves them empty) ------------------------------

# The SERVICE token. It reads PR metadata and diffs, clones the repositories, and runs the
# poller's searches — it never posts. Every comment, review and approval goes out under the
# signed-in reviewer's OWN token, which the dashboard stores encrypted per user.
#
# Fine-grained PAT (recommended): Repository access = every repo in REPOS (or "All
# repositories" under the owner when using REPO_ALLOW_ORG); Permissions = Pull requests: Read
# and write, Contents: Read, Metadata: Read. Read and write is what GitHub requires for this
# path to reach review threads; nothing in the service path writes with it.
# A classic PAT with `repo` scope also works. Do not add `read:org`: the only call that needed
# it was `gh pr view --json reviewRequests`, and the REST endpoints carry the same data.
GITHUB_PAT=

# A Slack incoming webhook. Point it at a private channel — the cards name PR titles and
# authors. Leave empty to run without Slack; the dashboard still works.
SLACK_WEBHOOK=

# Optional: a Slack bot token + channel ID instead of (or as well as) the webhook. With these
# set, the review-ready message threads under the review-request card. Without them Slack
# falls back to the webhook, which is send-only (a fresh message each time).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# A Discord channel webhook (channel settings → Integrations → Webhooks). Cards arrive as an
# embed and mention the reviewer by the Discord user ID they saved in Integrations.
DISCORD_WEBHOOK=

# Any HTTPS endpoint that accepts a JSON POST — Teams, Zapier, n8n, your own service. Every
# event (review_requested, review_ready, review_stopped, qa_ready) is one JSON object; see
# the Integrations page or docs/guides/notifications for the schema. With WEBHOOK_SECRET set
# the body is signed: X-ReviewStage-Signature: sha256=HMAC-SHA256(secret, body).
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional: GitHub → ReviewStage webhooks, for instant review-request cards instead of waiting
# for the next poll. Generate a random string (openssl rand -hex 32), paste it here AND in the
# GitHub webhook form (repo or org → Settings → Webhooks → Add webhook; payload URL
# <PUBLIC_URL>/webhooks/github, content type application/json, events "Pull requests" +
# "Pull request reviews"). Every delivery is HMAC-verified against this value; unset = the
# endpoint answers 503 and polling does all the work. Restart the server after changing.
GITHUB_WEBHOOK_SECRET=

# Which backends fire, comma-separated: slack, discord, generic, none. Empty = whichever of
# the URLs above are set (so an existing Slack-only install changes nothing). Can be
# overridden without a restart from the dashboard's Settings page.
NOTIFY_BACKENDS=

# --- per-install values (bootstrap prompts for these on first run) ----------------------------

# The GitHub repositories this instance reviews, as owner/name — comma-separated (quote the
# value if you separate with spaces or newlines: the file is sourced by bash). REQUIRED: at
# least one. `REPO=owner/name` is still accepted as a single-entry alias; if both are set the
# lists are unioned. Each entry is validated (owner/name shape) at startup.
REPOS=
REPO=

# Optional: an org (or user) whose repositories are accepted on demand, in addition to the
# explicit list above. The poller discovers them by searching for open review requests to each
# signed-in user under that owner (`gh search prs --owner <org> --review-requested=<login>`) and
# the base clone is made lazily on the first review. The SERVICE token (GITHUB_PAT) must be
# able to see the org for discovery to find anything. Empty = explicit list only.
REPO_ALLOW_ORG=

# Your GitHub login. Must match the account the PAT belongs to.
REVIEWER=

# Where browsers reach the dashboard — the hostname your reverse proxy forwards to the server
# on 127.0.0.1:8899. REQUIRED, no default. Every Slack button and the OAuth callback are built
# from it, so get it right before going live. No trailing slash.
PUBLIC_URL=

# --- GitHub login (one-click sign-in instead of pasting a token) -------------------------------

# Create an OAuth App (github.com/settings/developers) or a GitHub App, with callback URL
#   <PUBLIC_URL>/oauth/callback
# and paste its client ID + secret here. Leave empty and the login page offers token
# sign-in only. Restart the server after changing.
GH_CLIENT_ID=
GH_CLIENT_SECRET=
# OAuth App: set to `repo` — the smallest classic scope that can comment on and approve a PR in
# a private repository (`public_repo` if every repo is public). OAuth Apps cannot request
# fine-grained per-repository permissions; only a GitHub App can. Tick "Expire user access
# tokens" when creating the app and tokens last 8 hours, refreshed here automatically.
# GitHub App: leave EMPTY — permissions come from the app instead of a scope.
GH_OAUTH_SCOPES=

# --- defaults that are usually right ----------------------------------------------------------

# Auto-generated by bootstrap. Signs every dashboard link. Rotating it invalidates
# outstanding Slack buttons, which is the correct move if a link ever leaks.
RS_SECRET=

# 1 = the dashboard renders and the buttons work, but nothing is ever written to GitHub.
# Ships as 1 on purpose. Flip to 0 only after a dry run you have compared by hand, and
# restart the server afterwards — it reads this file once, at startup.
DRY_RUN=1

# 1 skips PRs opened by bots. Default 0: AI-written PRs are where a skeptical review pays
# off most, and they are often the bulk of the queue. Overridable from Settings.
SKIP_BOT_PRS=0

# Ignore review requests on PRs older than this many days. Overridable from Settings.
RS_MAX_PR_AGE_DAYS=45

# NOTE: the poll interval and the poller on/off switch are NOT .env keys any more — they live
# in the dashboard's Settings page (written to ~/.reviewstage/settings.json, read by the
# poller every cycle). settings.json > .env > default for every key it carries.

# Refuse to start a review below this much AVAILABLE RAM, in MB. The default means a 1 GB box
# cannot run a single review; give the machine at least 2 GB rather than lowering this.
MIN_FREE_MB=800

# The port the server listens on (127.0.0.1 only — put your reverse proxy in front of it).
# From source this is the whole story. On a DOCKER install do NOT set RS_PORT in .env: compose
# reads the same file to interpolate the published port and to build the container environment,
# so the server moves while the publish does not. There, use `RS_PORT=9000 docker compose up -d`.
RS_PORT=8899

# Signed links now carry the repository (HMAC over action:owner/name#pr:expiry). Links minted
# before the repo dimension existed (action:pr:expiry) keep verifying for this many days after
# the first start of the repo-aware server, so Slack cards already sent keep working during the
# transition. 0 = reject them at once.
RS_SIGNATURE_GRACE_DAYS=7

# --- optional: risk-area banners ---------------------------------------------------------------

# Paths your team wants reviewers to look harder at. Comma-separated `label:pattern` rules; a
# rule matches when a changed file path equals the glob or contains the substring, and the
# dashboard then shows a "Touches <label> paths" banner on the review. Context only — never a
# gate, never routing. Empty (the default) = feature off. Example:
#   RISK_PATHS=billing:src/billing/,auth:*/auth/*,migrations:db/migrate/
RISK_PATHS=
# Per-repository override: RISK_PATHS__<OWNER>__<NAME> replaces RISK_PATHS for that repo. The
# key is the repo upper-cased with `/` → `__` and every other non [A-Z0-9_] character → `_`,
# e.g. acme/widgets-web → RISK_PATHS__ACME__WIDGETS_WEB. Unset = the global RISK_PATHS applies.
#   RISK_PATHS__ACME__WIDGETS_WEB=checkout:src/checkout/

# --- optional: several hostnames for one instance ---------------------------------------------

# If more than one hostname points at this instance (say, an old one kept alive so bookmarks
# and already-sent Slack links keep working), list them all here, comma-separated. A visit on
# one hostname without a session bounces through another to pick up an existing login.
# Empty = feature off.
RS_HOST_ALIASES=

# A parent domain to scope the session cookie to, so one login covers every alias above.
# Empty = host-only cookies, which is right for a single hostname.
RS_DOMAIN=

# --- legacy keys ------------------------------------------------------------------------------

# Earlier versions derived the public hostname as reviewstage-<RS_ENV>.<RS_DOMAIN>. An .env
# that still carries RS_ENV together with RS_DOMAIN keeps working without PUBLIC_URL;
# new installs should set PUBLIC_URL and leave this empty.
RS_ENV=
